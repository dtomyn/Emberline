{
  "name": "emberline-saskatchewan",
  "version": "1.0.0",
  "description": "Emberline: an animated atlas of Saskatchewan wildfires (CNFDB 1959–present), with live SPSA GIS data",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node server/index.mjs",
    "load:cnfdb": "node scripts/load-cnfdb.mjs",
    "load:cnfdb:refresh": "node scripts/load-cnfdb.mjs --refresh",
    "load:spsa": "node scripts/load-csv.mjs --source spsa",
    "load:spread": "node scripts/load-spread.mjs",
    "make:voice": "node scripts/make-voice.mjs",
    "film": "node scripts/make-film.mjs",
    "make:social": "node scripts/make-social.mjs",
    "load:mock": "node scripts/generate-mock.mjs && node scripts/load-csv.mjs data/raw/spsa_fires_mock.csv --source mock",
    "export:json": "node scripts/export-json.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test": "node --test tests/"
  },
  "license": "MIT"
}
